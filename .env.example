# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Models
OPENROUTER_DEFAULT_MODEL=openrouterModelID

# Optional mehrere Modelle (Komma-separiert) für Multi-Model Evaluation
# Beispiel für nur kostenlose Modelle:
# AI_MODELS=qwen/qwen-2.5-coder-32b-instruct:free,meta-llama/llama-3.2-3b-instruct:free,microsoft/phi-3-mini-128k-instruct:free,google/gemma-2-9b-it:free
# Wenn nicht gesetzt, fällt Code auf OPENROUTER_DEFAULT_MODEL zurück.
AI_MODELS=


