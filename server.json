{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.notaisu/allyproof",
  "title": "Allyproof",
  "description": "WCAG 2.2 AA accessibility checker for HTML, React, Vue, Svelte, Angular and Astro code.",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/NotAisu/Accessibility_Extension",
    "source": "github"
  },
  "websiteUrl": "https://github.com/NotAisu/Accessibility_Extension#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "allyproof",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
