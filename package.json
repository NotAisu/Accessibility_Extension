{
  "name": "allyproof",
  "displayName": "Allyproof – WCAG 2.2 Accessibility Checker",
  "description": "WCAG 2.2 accessibility checks and AI-assisted fixes, starting with HTML.",
  "version": "0.0.1",
  "publisher": "notaisu",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotAisu/Accessibility_Extension.git"
  },
  "bugs": {
    "url": "https://github.com/NotAisu/Accessibility_Extension/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag 2.2",
    "axe",
    "aria",
    "html",
    "react",
    "vue",
    "svelte"
  ],
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "AI"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.mjs",
  "contributes": {
    "commands": [
      {
        "command": "allyproof.startAIReview",
        "title": "Start AI Review",
        "category": "Allyproof"
      },
      {
        "command": "allyproof.cancelAIReview",
        "title": "Cancel AI Review",
        "category": "Allyproof"
      },
      {
        "command": "allyproof.filterFindings",
        "title": "Filter Findings",
        "category": "Allyproof",
        "icon": "$(filter)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "allyproof.findings",
          "name": "Accessibility Findings"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "allyproof.findings",
        "contents": "No Findings in the open files."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "allyproof.startAIReview",
          "when": "allyproof.aiAvailable"
        },
        {
          "command": "allyproof.cancelAIReview",
          "when": "allyproof.aiAvailable"
        }
      ],
      "view/title": [
        {
          "command": "allyproof.filterFindings",
          "when": "view == allyproof.findings",
          "group": "navigation"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "a11y_check",
        "toolReferenceName": "a11y_check",
        "displayName": "Allyproof Check",
        "icon": "$(checklist)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Check a file or proposed code against WCAG 2.2 AA with Allyproof's static Check.",
        "modelDescription": "Runs Allyproof's deterministic WCAG 2.2 AA Check on frontend code and returns its Findings (1-based line, WCAG criteria, rule, severity, message, explanation, help URL) and the criteria that Need Review because the Check cannot decide them from source. Pass filePath to check a workspace file as it is open in the editor, code with languageId to check proposed code, or filePath and code to check proposed code for that file, for example to verify a fix before applying it. Call it before reviewing accessibility yourself and only review what it cannot decide.",
        "when": "allyproof.aiAvailable",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Workspace-relative or absolute path of the file to check."
            },
            "code": {
              "type": "string",
              "description": "Proposed code to check instead of the file's current text."
            },
            "languageId": {
              "type": "string",
              "description": "VS Code language id of code, for example html or typescriptreact. Defaults to the language of filePath."
            }
          }
        }
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/allyproof/SKILL.md",
        "when": "allyproof.aiAvailable"
      }
    ],
    "configuration": {
      "title": "Allyproof",
      "properties": {
        "allyproof.aiReview.auto": {
          "type": "boolean",
          "default": false,
          "description": "Also start an AI Review of the active file when it is saved. Off by default: code is only sent to the AI provider when you start a review."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test scripts",
    "test:gate": "ts-node test/ground-truth/gate.ts",
    "test:bundle-gate": "scripts/bundle-gate.sh",
    "prepare": "husky",
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js --production && ts-node scripts/third-party-notices.ts",
    "package": "vsce package",
    "test:unit": "mocha",
    "verify": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run test:unit && npm run test:gate && npm run test:bundle-gate"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/mocha": "10.0.6",
    "@types/node": "24.13.6",
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mocha": "10.4.0",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@html-eslint/eslint-plugin": "0.68.0",
    "@html-eslint/parser": "0.68.0",
    "@typescript-eslint/parser": "8.72.2",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "jsdom": "26.1.0",
    "svelte": "5.57.3",
    "typescript": "5.4.5",
    "vue-eslint-parser": "10.4.2"
  }
}
