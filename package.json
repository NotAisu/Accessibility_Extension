{
  "name": "allyproof",
  "displayName": "Allyproof – WCAG 2.2 Accessibility Checker",
  "description": "WCAG 2.2 accessibility checks and AI-assisted fixes, starting with HTML.",
  "version": "0.0.1",
  "publisher": "notaisu",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotAisu/Accessibility_Extension.git"
  },
  "bugs": {
    "url": "https://github.com/NotAisu/Accessibility_Extension/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag 2.2",
    "axe",
    "aria",
    "html",
    "react",
    "vue",
    "svelte"
  ],
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "AI"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.mjs",
  "contributes": {
    "commands": [
      {
        "command": "allyproof.startAIReview",
        "title": "Start AI Review",
        "category": "Allyproof"
      },
      {
        "command": "allyproof.cancelAIReview",
        "title": "Cancel AI Review",
        "category": "Allyproof"
      }
    ],
    "configuration": {
      "title": "Allyproof",
      "properties": {
        "allyproof.aiReview.auto": {
          "type": "boolean",
          "default": false,
          "description": "Also start an AI Review of the active file when it is saved. Off by default: code is only sent to the AI provider when you start a review."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test scripts",
    "test:gate": "ts-node test/ground-truth/gate.ts",
    "test:bundle-gate": "scripts/bundle-gate.sh",
    "prepare": "husky",
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js --production && ts-node scripts/third-party-notices.ts",
    "package": "vsce package",
    "test:unit": "mocha",
    "verify": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run test:unit && npm run test:gate && npm run test:bundle-gate"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/mocha": "10.0.6",
    "@types/node": "24.13.6",
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mocha": "10.4.0",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@html-eslint/eslint-plugin": "0.68.0",
    "@html-eslint/parser": "0.68.0",
    "@typescript-eslint/parser": "8.72.2",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "jsdom": "26.1.0",
    "svelte": "5.57.3",
    "typescript": "5.4.5"
  }
}
