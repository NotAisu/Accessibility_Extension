{
  "name": "allyproof",
  "displayName": "Allyproof – WCAG 2.2 Accessibility Checker",
  "description": "WCAG 2.2 accessibility checks and AI-assisted fixes, starting with HTML.",
  "version": "0.0.1",
  "publisher": "notaisu",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotAisu/Accessibility_Extension.git"
  },
  "bugs": {
    "url": "https://github.com/NotAisu/Accessibility_Extension/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag 2.2",
    "axe",
    "aria",
    "html",
    "react",
    "vue",
    "svelte"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "AI"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "allyproof.startAIReview",
        "title": "Start AI Review",
        "category": "Allyproof"
      },
      {
        "command": "allyproof.fixWithAI",
        "title": "Fix with AI",
        "category": "Allyproof"
      },
      {
        "command": "allyproof.testConnection",
        "title": "Test AI Connection",
        "category": "Allyproof"
      },
      {
        "command": "allyproof.clearRecentAIMemory",
        "title": "Clear Recent AI Fix Memory",
        "category": "Allyproof"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "allyproof.fixWithAI",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Allyproof",
      "properties": {
        "accessibility.aiProvider": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "github-copilot"
          ],
          "description": "AI provider for accessibility fixes"
        },
        "accessibility.aiAnalyzer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI Review for WCAG problems a Check cannot detect"
        },
        "accessibility.aiAnalyzer.scope": {
          "type": "string",
          "default": "visible",
          "enum": [
            "visible",
            "document"
          ],
          "description": "Analysis scope: visible code only or complete document"
        },
        "accessibility.aiAnalyzer.recentFixSuppressionTTL": {
          "type": "number",
          "default": 300000,
          "description": "TTL in ms for suppressing re-reporting of recently AI-fixed lines (set 0 to disable)"
        },
        "accessibility.localLLM.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:1234",
          "description": "Local LLM server endpoint (LM Studio, Ollama, etc.)"
        },
        "accessibility.localLLM.model": {
          "type": "string",
          "default": "mistralai/devstral-small-2507",
          "description": "Local LLM model identifier"
        },
        "accessibility.githubCopilot.model": {
          "type": "string",
          "default": "gpt-4o",
          "enum": [
            "gpt-4.1",
            "gpt-4o",
            "claude-3.5-sonnet",
            "claude-3.7-sonnet",
            "claude-3.7-sonnet-thinking",
            "claude-4-sonnet",
            "gemini-2.0-flash",
            "gemini-2.5-pro",
            "o3-mini",
            "o4-mini"
          ],
          "description": "GitHub Copilot model selection"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src test --ext ts",
    "test:axe": "npm run pretest && node out/test/axe-cli.js",
    "test:ai": "npm run pretest && node out/test/ai-cli.js",
    "generate:expected": "ts-node test/scripts/generate-expected.ts",
    "test:combined": "npm run pretest && node out/test/combined-cli.js",
    "test:mocha": "vscode-test",
    "prepare": "husky",
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js --production",
    "package": "vsce package",
    "test:unit": "mocha"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/glob": "8.1.0",
    "@types/jsdom": "21.1.7",
    "@types/mocha": "10.0.6",
    "@types/node": "18.19.34",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "7.7.1",
    "@typescript-eslint/parser": "7.7.1",
    "@vscode/test-cli": "0.0.9",
    "@vscode/test-electron": "2.3.9",
    "@vscode/vsce": "4.1.1",
    "dotenv": "17.2.1",
    "esbuild": "0.28.2",
    "eslint": "8.57.0",
    "glob": "8.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mocha": "10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5",
    "vue-eslint-parser": "10.2.0"
  },
  "dependencies": {
    "axe-core": "4.8.4",
    "jsdom": "26.1.0"
  }
}
