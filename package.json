{
  "name": "accessibility-extension",
  "displayName": "Accessibility Extension",
  "description": "WCAG 2.2 linting and quick fixes for frontend developers.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "accessibility-extension.fixWithAI",
        "title": "Fix with Local AI"
      },
      {
        "command": "accessibility-extension.fixWithAISemantic",
        "title": "Fix with AI (Semantic)"
      },
      {
        "command": "accessibility-extension.testConnection",
        "title": "Test AI Connection"
      },
      {
        "command": "accessibility-extension.codeTutorClear",
        "title": "Accessibility Tutor: Annotationen löschen",
        "icon": "$(clear-all)"
      },
      {
        "command": "accessibility-extension.openDashboard",
        "title": "Open Accessibility Dashboard"
      },
      {
        "command": "accessibility-extension.openSettings",
        "title": "Open AI Settings"
      },
      {
        "command": "accessibility-extension.startAIAnalysis",
        "title": "Start AI Semantic Analysis"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "accessibility-extension.codeTutorClear"
        }
      ]
    },
    "views": {
      "aiAccessibility": [
        {
          "id": "aiAccessibilitySettings",
          "name": "AI Settings",
          "icon": "$(settings-gear)",
          "type": "webview",
          "when": "true"
        },
        {
          "id": "accessibilityMetricsDashboard",
          "name": "Metrics Dashboard",
          "icon": "$(graph)",
          "type": "webview",
          "when": "true"
        }
      ],
      "explorer": [
        {
          "id": "accessibilityReminders",
          "name": "Accessibility Reminders",
          "icon": "$(checklist)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiAccessibility",
          "title": "AI Accessibility",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "configuration": {
      "title": "Accessibility Extension",
      "properties": {
        "accessibility.aiProvider": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "github-copilot",
            "custom-api"
          ],
          "description": "AI provider for accessibility fixes"
        },
        "accessibility.aiAnalyzer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI semantic analyzer for WCAG violations"
        },
        "accessibility.aiAnalyzer.scope": {
          "type": "string",
          "default": "visible",
          "enum": [
            "visible",
            "document"
          ],
          "description": "Analysis scope: visible code only or complete document"
        },
        "accessibility.aiAnalyzer.promptStrategy": {
          "type": "string",
          "default": "direct-instruction",
          "enum": [
            "direct-instruction",
            "few-shot",
            "chain-of-thought",
            "role-based"
          ],
          "description": "AI prompt strategy: direct-instruction (optimized zero-shot), few-shot (pattern learning), chain-of-thought (structured reasoning), role-based (multi-perspective)"
        },
      "accessibility.aiAnalyzer.recentFixSuppressionTTL": {
        "type": "number",
        "default": 300000,
        "description": "TTL in ms for suppressing re-reporting of recently AI-fixed lines (set 0 to disable)"
      },
        "accessibility.localLLM.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:1234",
          "description": "Local LLM server endpoint (LM Studio, Ollama, etc.)"
        },
        "accessibility.localLLM.model": {
          "type": "string",
          "default": "mistralai/devstral-small-2507",
          "description": "Local LLM model identifier"
        },
        "accessibility.githubCopilot.model": {
          "type": "string",
          "default": "gpt-4o",
          "enum": [
            "gpt-4.1",
            "gpt-4o",
            "claude-3.5-sonnet",
            "claude-3.7-sonnet",
            "claude-3.7-sonnet-thinking",
            "claude-4-sonnet",
            "gemini-2.0-flash",
            "gemini-2.5-pro",
            "o3-mini",
            "o4-mini"
          ],
          "description": "GitHub Copilot model selection"
        },
        "accessibility.customAPI.endpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1/chat/completions",
          "description": "(Read-only) OpenRouter endpoint – wird intern genutzt"
        },
        "accessibility.customAPI.model": {
          "type": "string",
          "default": "qwen/qwen3-coder:free",
          "description": "OpenRouter Modell-ID (z.B. qwen/qwen3-coder:free)"
        },
        "accessibility.customAPI.headers": {
          "type": "object",
          "default": {},
          "description": "Custom headers for API requests"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src test --ext ts",
    "test:axe": "npm run pretest && node out/test/axe-cli.js",
    "test:ai": "npm run pretest && node out/test/ai-cli.js",
    "test:combined": "npm run pretest && node out/test/combined-cli.js",
    "test:mocha": "vscode-test",
    "test:direct": "node out/test/cli.js"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/glob": "8.1.0",
    "@types/mocha": "10.0.6",
    "@types/node": "18.19.34",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "7.7.1",
    "@typescript-eslint/parser": "7.7.1",
    "@vscode/test-cli": "0.0.9",
    "@vscode/test-electron": "2.3.9",
    "eslint": "8.57.0",
    "glob": "8.1.0",
    "mocha": "10.4.0",
    "typescript": "5.4.5",
    "vue-eslint-parser": "10.2.0"
  },
  "dependencies": {
    "@types/jsdom": "21.1.7",
    "@types/react": "19.1.10",
    "axe-core": "4.8.4",
    "dotenv": "17.2.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-vuejs-accessibility": "2.4.1",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "vue": "3.5.19"
  }
}
